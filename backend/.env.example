# ==============================================================================
# Trendlume - Deployment & Security Environment Configuration
# ==============================================================================
# All runtime AI provider credentials and configurations (OpenAI, DeepSeek, 
# Tavily, ComfyUI, Edge-TTS, Douyin, etc.) are managed dynamically via SQLite 
# and the Web Settings UI with AES/Fernet encryption.
# ==============================================================================

# --- Application Server ---
APP_NAME="Trendlume"
DEBUG=false
HOST="127.0.0.1"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Storage & SQLite Database ---
# DATA_DIR="../data"

# --- Task Execution & Worker Pool ---
TASK_TIMEOUT_SECONDS=600
JOB_POLL_INTERVAL_SECONDS=1
JOB_HEARTBEAT_INTERVAL_SECONDS=10
JOB_STALE_AFTER_SECONDS=45
SCHEDULE_MISFIRE_GRACE_SECONDS=60
MAX_CONCURRENT_WORKERS=2
MAX_JOB_RETRIES=3

# --- Security Root Secret (Never stored in SQLite) ---
# Used for symmetric Fernet/AES encryption of API keys and credentials in SQLite.
# Required for any non-loopback deployment. Generate a random 32-byte secret
# (e.g. openssl rand -base64 32); the placeholder below is rejected at startup.
ENCRYPTION_KEY="your-secure-random-encryption-key-here"
CREDENTIAL_ENCRYPTION_KEY="your-secure-random-encryption-key-here"
